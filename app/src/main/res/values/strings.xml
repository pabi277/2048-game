    <!-- How to play (phase 4). -->
    <string name="how_to_play_title">How to play</string>
    <string name="how_to_play_rule_1">Swipe — or use the direction pad — to slide every tile at once.</string>
    <string name="how_to_play_rule_2">Two tiles with the same number merge into one tile of their sum.</string>
    <string name="how_to_play_rule_3">A tile can merge only once per move.</string>
    <string name="how_to_play_rule_4">After a valid move one new tile appears: a 2 nine times in ten, a 4 the rest.</string>
    <string name="how_to_play_rule_5">Your score grows by the value of each merge.</string>
    <string name="how_to_play_rule_6">Reach 2048 to win. Then keep playing, or start again.</string>
    <string name="how_to_play_rule_7">The game ends only when the board is full and no neighbours match.</string>
    <string name="how_to_play_scoring_title">Scoring example</string>
    <string name="how_to_play_scoring_body">Merging two 8s makes a 16 and adds 16 to your score.</string>
    <string name="how_to_play_undo_title">Undo</string>
    <string name="how_to_play_undo_body">One free undo per game — also after game over. A rewarded ad can earn one more.</string>
    <string name="how_to_play_controls_title">Controls</string>
    <string name="how_to_play_controls_body">Swipe anywhere on the board, or tap the direction pad. Tablets and Chromebooks can use the arrow keys.</string>

